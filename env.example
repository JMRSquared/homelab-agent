# Template for /etc/homelab-agent/env on LXC 104 (mode 0600, never committed
# with real values). See docs/deploy.md for the full deployment runbook.

# --- Required ---
MINIMAX_API_KEY=
HOSTCTL_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
JELLYFIN_KEY=
JELLYSEERR_KEY=
IMMICH_KEY=
ADGUARD_BASIC_AUTH=

# --- Mail (send_email) ---
# MAIL_PASSWORD is not optional in practice: send_email fails with a clear
# typed error naming this variable until it's set. Left blank here (like
# JELLYFIN_KEY etc. above) because only the owner has the password for
# admin@mail.jmrsquared.com - deploy/set-secrets.sh asks for it and every
# other tool keeps working without it.
MAIL_PASSWORD=
# MAIL_SMTP_HOST=10.0.0.167
# MAIL_SMTP_PORT=465
# MAIL_FROM=admin@mail.jmrsquared.com
# IMAP host/port for mail_list_messages/mail_read_message (reading the same
# mailbox send_email writes from). Same box as MAIL_SMTP_HOST by default -
# Stalwart serves IMAPS on 993 alongside SMTPS on 465.
# MAIL_IMAP_HOST=10.0.0.167
# MAIL_IMAP_PORT=993

# --- Optional (agent/config.py falls back to these defaults when unset) ---
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3
# HOSTCTL_URL=http://10.0.0.2:8710
# AGENT_DB=/tank/dev/agent/agent.db
# AGENT_BRAIN=/tank/dev/agent/brain.md
# Extra skills (markdown runbooks) added on the box without a redeploy; a file
# here replaces a bundled agent/skills/ skill of the same name.
# AGENT_SKILLS_DIR=/tank/dev/agent/skills
# AGENT_LISTS=/tank/dev/agent/lists

# Slug of the Uptime Kuma status page monitors_status() reads
# (http://10.0.0.165:3001/api/status-page/heartbeat/<slug>). Defaults to
# "homelab" - only set this if you named the status page something else.
# See docs/deploy.md step 5.
# UPTIME_KUMA_SLUG=homelab

# Whether a plain channel message (no @mention) gets a reply from the agent.
# Defaults to "1": talk to it like a person in any channel it's in. Set to
# "0" to require an explicit @mention in channels; DMs always get a reply
# either way. See docs/slack-setup.md step 5.
# SLACK_REPLY_WITHOUT_MENTION=1

# Where the agent posts on its own initiative: status updates/incidents, and
# the full tool-call audit trail. Not a gate on where it listens or replies
# - it replies in every channel it's a member of. See docs/slack-setup.md
# step 6.
# SLACK_CHANNEL_STATUS=#homelab-alerts
# SLACK_CHANNEL_LOG=#homelab-agent-log

# Whether Slack replies stream live (Thinking Steps: task cards for each
# tool call, reasoning surfaced as their detail) instead of appearing all at
# once when the reply is fully formed. Defaults to "1". Slack's own docs
# don't confirm whether streaming needs a paid plan on every workspace, so
# this exists as an off switch that needs no redeploy - if a workspace can't
# stream, the agent still falls back to posting one message per reply
# either way (see agent/slack_thinking.py), so this is only for turning the
# live view off deliberately, not a required workaround. Set to "0" to
# disable.
# SLACK_THINKING_STEPS=1

# Seconds between autonomous tick sweeps (state collection, diff, and - if
# something changed - a model call that can act on its own). Operational
# lever, not a deployment mode: leave at the default for normal running. 0
# disables the tick entirely (Slack still answers, nothing acts on its own)
# - useful to quiet the autonomous loop during an incident or while
# debugging a model that's behaving oddly, without stopping the service. See
# docs/deploy.md step 8.
# AGENT_TICK_SECONDS=60

# The self-improvement cycle (agent/improve.py, run every 10 minutes by
# deploy/homelab-improve.timer - a separate service from homelab-agent
# itself). Two independent caps on one cycle: AGENT_IMPROVE_TIMEOUT_S
# bounds the model call's wall clock; the tool-call round cap is set via
# AGENT_MAX_TOOL_ROUNDS in deploy/homelab-improve.service's own
# Environment= line (not here - it deliberately differs from the chat/tick
# path's default). AGENT_IMPROVE_LOCK is the flock path that keeps two
# cycles from overlapping; the default (/run/lock/homelab-improve.lock) is
# fine unless something else on the box already uses that path.
# AGENT_IMPROVE_TIMEOUT_S=540
# AGENT_IMPROVE_LOCK=/run/lock/homelab-improve.lock
